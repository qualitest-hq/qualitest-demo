package ${packageName}.apiController;

import java.util.List;
import lombok.AllArgsConstructor;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import com.demo.common.core.controller.ApiController;
import com.demo.common.core.domain.R;
import ${packageName}.domain.${ClassName};
import ${packageName}.apiParams.${ClassName}ApiParams;
import ${packageName}.apiResult.${ClassName}ApiResult;
import ${packageName}.service.I${ClassName}Service;
import com.demo.common.core.text.Convert;
#if($table.crud || $table.sub)
import com.demo.common.core.page.TableData;
#end

/**
 * ${functionName}客户端 API
 *
 * @author ${author}
 * @date ${datetime}
 */
@RestController
@RequestMapping("/api/${moduleName}/${businessName}")
@AllArgsConstructor
public class ${ClassName}ApiController extends ApiController {

    private final I${ClassName}Service ${className}Service;

    /**
     * 查询${functionName}列表
     */
    @GetMapping("/list")
#if($table.crud || $table.sub)
    public R<TableData<${ClassName}ApiResult>> list(${ClassName}ApiParams params) {
        startPage();
        List<${ClassName}ApiResult> list = ${className}Service.select${ClassName}ApiResultList(params);
        return getTableData(list);
    }
#elseif($table.tree)
    public R<List<${ClassName}ApiResult>> list(${ClassName}ApiParams params) {
        List<${ClassName}ApiResult> list = ${className}Service.select${ClassName}ApiResultList(params);
        return ok(list);
    }
#end

    /**
     * 获取${functionName}详细信息
     */
    @GetMapping("/{${pkColumn.javaField}}")
    public R<${ClassName}ApiResult> getInfo(@PathVariable("${pkColumn.javaField}") ${pkColumn.javaType} ${pkColumn.javaField}) {
        return ok(${className}Service.select${ClassName}ApiResult(${pkColumn.javaField}));
    }

    /**
     * 新增${functionName}
     */
    @PostMapping
    public R<Void> add(@RequestBody ${ClassName} ${className}) {
        return toR(${className}Service.insert${ClassName}(${className}));
    }

    /**
     * 修改${functionName}
     */
    @PutMapping
    public R<Void> edit(@RequestBody ${ClassName} ${className}) {
        return toR(${className}Service.update${ClassName}(${className}));
    }

    /**
     * 删除${functionName}
     */
    @DeleteMapping("/{${pkColumn.javaField}s}")
    public R<Void> remove(@PathVariable ${pkColumn.javaType}[] ${pkColumn.javaField}s) {
#if($pkColumn.columnType == 'bigint')
        List<Long> idList = Convert.toLongList(${pkColumn.javaField}s);
#else
        List<String> idList = Convert.toStrList(${pkColumn.javaField}s);
#end
#if($logicDelete)
        return toR(${className}Service.logicDelete${ClassName}ByIdList(idList));
#else
        return toR(${className}Service.delete${ClassName}ByIdList(idList));
#end
    }
}
