package ${packageName}.apiResult;

import com.fasterxml.jackson.annotation.JsonFormat;
#foreach ($import in $importList)
import ${import};
#end
import lombok.*;
import org.apache.ibatis.type.Alias;

import java.io.Serializable;

/**
 * ${functionName} ApiResult 对象（客户端）
 *
 * @author ${author}
 * @since ${datetime}
 */
@Getter
@Setter
@ToString
@AllArgsConstructor
@NoArgsConstructor
@Builder
@Alias("${ClassName}ApiResult")
public class ${ClassName}ApiResult implements Serializable {

#foreach ($column in $columns)
#if(!$table.isResultSuperColumn($column.javaField))
    /**
     * $column.columnComment
     */
#if($column.javaType == 'Date')
    @JsonFormat(pattern = "yyyy-MM-dd HH:mm:ss")
#elseif($column.javaType == 'Long')
    @JsonFormat(shape = JsonFormat.Shape.STRING)
#end
    private $column.javaType $column.javaField;

#end
#end
#if($hasCreateBy)

    /**
     * 创建者
     */
    private String creator;
#end
#if($hasUpdateBy)

    /**
     * 更新者
     */
    private String updater;
#end
#if($table.sub)

    /** $table.subTable.functionName信息 */
    private List<${subClassName}> ${subclassName}List;
#end

}
