# qualitest-demo — 环境变量示例（复制为 .env；勿提交 .env）
# 对应 Spring profile：dev / prod / docker；亦用于 docker compose

# --- Compose 宿主机端口（默认避开主仓 qualitest 的 80/3306/6379）---
WEB_PORT=8082
APP_PORT=8081
MYSQL_PORT=3307
REDIS_PORT=6380
MYSQL_ROOT_PASSWORD=qualitest

# --- 服务 ---
SERVER_PORT=8081
DEMO_PROFILE=D:/demo/uploadPath

# --- MySQL（本机 dev；Compose 内由 compose 注入）---
SPRING_DATASOURCE_DRUID_MASTER_URL=jdbc:mysql://localhost:3306/qualitest-demo?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8
SPRING_DATASOURCE_DRUID_MASTER_USERNAME=root
SPRING_DATASOURCE_DRUID_MASTER_PASSWORD=change-me

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=11
SPRING_DATA_REDIS_PASSWORD=

# --- JWT（生产 / Compose 务必改成强随机值）---
TOKEN_SECRET=demo-compose-dev-change-me-32chars!!!!!!
TOKEN_EXPIRE_TIME=1440

# --- 日志 ---
LOGGING_LEVEL_COM_DEMO=info

# --- 可选 RustFS（S3；Compose：scripts/quick-start.* rustfs）---
# 宿主机端口
# RUSTFS_API_PORT=9000
# RUSTFS_CONSOLE_PORT=9001
# 与 RustFS 容器共用的根密钥（同时注入 app）
# RUSTFS_ACCESS_KEY=rustfsadmin
# RUSTFS_SECRET_KEY=rustfsadmin
# 本机 mvn 跑后端时（endpoint 用 127.0.0.1；Compose 内默认 http://rustfs:9000）
# DEMO_RUSTFS_ENABLED=true
# DEMO_RUSTFS_ENDPOINT=http://127.0.0.1:9000
# DEMO_RUSTFS_ACCESS_KEY=rustfsadmin
# DEMO_RUSTFS_SECRET_KEY=rustfsadmin
# DEMO_RUSTFS_BUCKET=qualitest-demo
# DEMO_RUSTFS_PUBLIC_BASE_URL=http://127.0.0.1:9000/qualitest-demo
